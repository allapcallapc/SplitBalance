{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "splitbalance-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8080",
        "--dart-define=SUPABASE_URL=REPLACE_WITH_STAGING_SUPABASE_URL",
        "--dart-define=SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_SUPABASE_ANON_KEY"
      ],
      "port": 8080
    }
  ]
}
